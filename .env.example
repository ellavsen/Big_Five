# Скопируй в .env и заполни своими значениями. Сам .env в git не попадает.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=

# USER — имя пользователя системы (узнать: whoami), PASSWORD — если задан.
# Базу создать заранее: createdb neuro_db
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/neuro_db

# Адрес Mini App. Обязательно https — другие Telegram не открывает.
# Пусто — кнопка «Открыть карту» просто не показывается, бот работает как обычно.
# Локально проще всего получить туннелем: cloudflared tunnel --url http://localhost:8000
WEBAPP_URL=
